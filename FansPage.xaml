<Page x:Class="Cryo.FansPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="FansPage" Background="#F4F7F9">

    <Page.Resources>
        <!-- Premium Gradient Accent -->
        <LinearGradientBrush x:Key="PremiumAccent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00C6FF" Offset="0.0" />
            <GradientStop Color="#0072FF" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="PremiumCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="32" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,32" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.03" Color="#000000" Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Button Animation -->
        <Style x:Key="PremiumButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="32,16" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ui:ControlHelper.CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Fans &amp; Power Control" FontSize="34" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,32" />
        
        <Border Grid.Row="1" Style="{StaticResource PremiumCard}">
            <StackPanel>
                <TextBlock Text="Windows Power Profiles" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,24" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PremiumButton}" Content="Power Saver" />
                    <!-- Highlighted "Active" Button with Gradient -->
                    <Button Content="Balanced" BorderThickness="0" Padding="32,16" ui:ControlHelper.CornerRadius="8" FontSize="15" FontWeight="Bold" Margin="0,0,16,0" Foreground="White" Background="{StaticResource PremiumAccent}" />
                    <Button Style="{StaticResource PremiumButton}" Content="High Performance" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PremiumCard}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Universal Fan Curve Configuration" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                <TextBlock Text="Fine-tune your hardware cooling profile. Universal fan control relies on specific manufacturer ACPI endpoints and may not be completely functional without vendor-specific driver support (e.g. ASUS System Control Interface)." 
                           TextWrapping="Wrap" Margin="0,0,0,40" Foreground="#64748B" FontSize="15" LineHeight="24" />
                
                <Slider Minimum="0" Maximum="100" Value="50" TickFrequency="10" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="#0072FF" />
                <TextBlock Text="Target Fan Speed: 50%" HorizontalAlignment="Center" Margin="0,16,0,0" FontWeight="Bold" Foreground="#0072FF" FontSize="16" />
                
                <Button Content="Apply Cooling Profile" Background="{StaticResource PremiumAccent}" Foreground="White" Padding="32,16" Margin="0,40,0,0" HorizontalAlignment="Left" ui:ControlHelper.CornerRadius="8" FontSize="15" FontWeight="Bold" BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
